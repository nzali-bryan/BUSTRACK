{% extends 'base.html.twig' %}

{% block title %}BusTrack{% endblock %}

{% block body %}
 {{ include('style/js.html.twig')}}
  {{ include('style/style.html.twig')}}

      
   {{ include('style.html.twig') }}
    <link rel="stylesheet" href="{{asset('css1/driver/conducteurs.css')}}">
    <link rel="stylesheet" href="{{asset('css1/driver/root.css')}}">
    <link rel="stylesheet" href="{{asset('css/bootstrap.css')}}">



        <div class="cube d-flex justify-content-center">

                <main style="width: 400px; " class="corps min-vh-100">
                    <div class="w-100">
                        <header class=" entete position-fixed align-items-center d-grid">
                            <span class=" fs-4 position-absolute start-0 mx-2">BUSTRACK</span>
                        
                            <div id="profil" class=" rounded-circle border  position-absolute end-0 mx-2 d-grid align-items-center" style="width:40px; height:40px;">
                                <i class="bi bi-person fs-1  position-absolute mb-2 my-1"><a href=""></a></i>
                            </div>
                        </header>
                    </div>
                    
                    <div class="conteneur">
                        <p>Utiliser ce panneau pour mettre votre direction à jour et votre statut en temps réel.</p>
                    </div>
                <div class="conteneur border border-2 bg-white rounded rounded-3">
                    
                    <h3>Trajet assigné</h3><hr>
                    <div class=" text-center"> 
                        <h2>Bus: {{bus.nom}}</h2><hr>
                        <h2>Trajet: {{trajet.nom}}</h2>
                    </div>

                </div>
                <div class="conteneur1 bg-white mt-3 rounded rounded-1 border border-2 border-secondary-subtle px-2">

                    <form method="post" action="{{ path('update_direction_bus', {'id': bus.id}) }}">
                    <div class="mb-3">
                        <label for="direction"><h3>Direction</h3></label>
                        <select name="direction" id="direction" class="form-control form_control">
                            {% for pointA in pointASC %}
                                {% for pointB in pointDESC %}
                                        <option value="{{ pointA.nom }} vers {{ pointB.nom }}">
                                            {{ pointA.nom }} vers {{ pointB.nom }}
                                        </option>
                                        <option value="{{ pointB.nom }} vers {{ pointA.nom }}">
                                            {{ pointB.nom }} vers {{ pointA.nom }}
                                        </option>
                                 
                                {% endfor %}
                            {% endfor %}
                        </select>
                    </div>

                    <input type="hidden" name="_token" value="{{ csrf_token('update_direction' ~ bus.id) }}">
                    <div class=" d-grid justify-content-center mb-1">
                         <button type="submit" class="ajouter text-center">Mettre à jour</button>                    
                    </div>
                    </form>
                        <h3>Statut du Bus</h3>
                            {{ form_start(form) }}
                        <div class=" mb-3">
                                {{ form_row(form.etat, {'attr': {
                                    'class': 'form-control form_control',
                                    'placeholder': ''
                                }}) }}
                        </div>


                    <div class=" d-grid justify-content-center mb-1">
                         <button type="submit" class="ajouter text-center">Mettre à jour</button>                    
                    </div>

                        {{ form_end(form) }}
                    


                </div>
                </main>

  
                
            </div>
            <script src="js/bootstrap.bundle.min.js"></script>

{% endblock %}