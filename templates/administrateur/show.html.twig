{% extends 'base.html.twig' %}

{% block title %}Administrateur{% endblock %}

{% block body %}
    <h1>Administrateur</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ administrateur.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ administrateur.Nom }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ administrateur.roles ? administrateur.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ administrateur.password }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_administrateur_index') }}">back to list</a>

    <a href="{{ path('app_administrateur_edit', {'id': administrateur.id}) }}">edit</a>

    {{ include('administrateur/_delete_form.html.twig') }}
{% endblock %}
