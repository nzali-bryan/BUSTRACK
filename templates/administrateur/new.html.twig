{% extends 'base.html.twig' %}

{% block title %}Créer un administrateur{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Créer un administrateur</h1>

    {{ form_start(form) }}

    <div class="mb-3">
        {{ form_label(form.nom) }}
        {{ form_widget(form.nom, {'attr': {'class': 'form-control form_control'}}) }}
        {{ form_errors(form.nom) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.username) }}
        {{ form_widget(form.username, {'attr': {'class': 'form-control form_control'}}) }}
        {{ form_errors(form.username) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.roles) }}
        {{ form_widget(form.roles, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.roles) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.password) }}
        {{ form_widget(form.password, {'attr': {'class': 'form-control form_control'}}) }}
        {{ form_errors(form.password) }}
    </div>

    <button class="btn btn-primary">Créer</button>

    {{ form_end(form) }}
</div>
{% endblock %}
