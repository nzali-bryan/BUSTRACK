{% extends 'base.html.twig' %}


{% block title %}BusTrack{% endblock %}
{% block body %}
{{ include('style.html.twig') }}  




  {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
        <link rel="stylesheet" href="css1/admin/accueil.css">
        <link rel="stylesheet" href="css1/admin/root.css">
        <link rel="stylesheet" href="css/bootstrap.css">
    {% endblock %}



<div class="d-flex">
    
 <div id="menu" class=" px-3 vh-100 borderDashboard border border-1" style="width: 250px;">
        
        <h1 class=" mb-5 text-center" style="color: white;"><span style="color: var(--color-btn-primary-hover);">Bus</span>Track</h1>
        <ul class="nav flex-column w-100 text-start">
            <li class="nav-item my-1">
                <a  class="nav-link  active  fs-3 colorDashboard" href="#">
                    <i class="bi bi-house"></i> <span class=" fs-5">Dashboard</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link  fs-3 colorDashboard" href="#">
                     <i class="fas fa-bus"></i><span class=" fs-5">Bus</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link   fs-3 colorDashboard" href="{{path('app_conducteurs_index')}}">
                   <i class="fas fa-user-tie"></i> <span class=" fs-5">Conducteurs</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link fs-3 colorDashboard" href="#">
                   <i class="fas fa-route"></i></i> <span class=" fs-5"> Trajet</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link fs-3 colorDashboard" href="#">
                   <i class="bi bi-geo-alt"></i><span class=" fs-6">Point</span>
                </a>
            </li>
            <li class="nav-item my-3">
                <a id="danger" class="nav-link text-danger fs-3 colorDashboard" href="{{path ('deconnexion')}}">
                    <i class="bi bi-box-arrow-right"></i> <span class=" fs-5">Déconnexion</span>
                </a>
            </li>
        </ul>
    </div>


    <!-- Contenu -->
    <div class="corps">
        <div id="animate" class="container-fluid Dashboard ">
        <h3 style="color: var(--color-text-primary);">Actions rapides</h3>
        <div class="mt-3  row gap-3 gap-4">
            <div class=" mx-2 pe-4 row gap-3 gap-4">
                <div class="col rounded action text-center d-grid align-items-center">
              <i class="fas fa-user-tie fs-1 colorIcon"></i>Ajouter un Conducteur
                </div>
                <div class="col rounded action text-center d-grid align-items-center">
                   <i class="fas fa-route fs-1 colorIcon"></i> Ajouter un Trajet
                </div>
                <div class="col  rounded action text-center d-grid align-items-center">
                    <i class="fas fa-map-marker-alt fs-1 colorIcon"></i>Ajouter un Point
                </div>

            </div>
            <div class="mt-3 pe-4 row  mx-2 gap-3 gap-4">
                <div class="col rounded action text-center d-grid align-items-center"><i class="fas fa-bus fs-1 colorIcon" ></i>Ajouter un Bus</div>
            </div>
            <section>
                <H3>Statistiques</H3>
                <div class=" mx-2 pe-4 row gap-3 gap-4">
                <div class="col rounded action text-center actionStat d-grid align-items-center">
                    <i class="fas fa-bus fs-1 colorIcon" >50</i> Bus Enregistrés
                </div>
                <div class="col rounded action text-center actionStat d-grid align-items-center">
                     <i class="fas fa-user-tie fs-1 colorIcon">49</i>Conducteurs Actifs
                </div>
                <div class="col  rounded action actionStat text-center d-grid align-items-center">
                    <i class="fas fa-map-marker-alt fs-1 colorIcon">134</i>Nombre de trajets
                </div>
            </section>


            </div>


        </div>
    </div>

</div>
        <script src="../../js/bootstrap.bundle.min.js"></script>
        <script>

        const links = document.querySelectorAll("#menu .nav-link");

        links.forEach(link => {
            link.addEventListener("click", function(){

                // enlever active sur tous les liens
                links.forEach(l => l.classList.remove("active"));

                // ajouter active au lien cliqué
                this.classList.add("active");

            });
        });
        </script>
    </div>




  

  
{% endblock %}
