{% extends 'base.html.twig' %}


{% block stylesheets %}
	{{ include('style/js.html.twig')}}
	{{ include('style/style.html.twig')}}
{% endblock %}
{% block title %}BusTrack
{% endblock %}
{% block body %}
	{{ include('style.html.twig') }}
	{% for message in app.flashes('admin_create_bus') %}
		{% if message %}
			<div class=" row w-100 d-flex justify-content-center align-items-center">
				<article class=" message ">
					<div id="toast-container text-center d-flex justify-content-center">
						<span class="fs-2">
							<i class="bi bi-check-circle message-success fs-2 fw-bold"></i>
							{{ message }}
						</span>
					</div>
				</article>
			</div>
		{% endif %}
	{% endfor %}
	{% for message in app.flashes('admin_create_conducteur') %}
		{% if message %}
			<div class=" row w-100 d-flex justify-content-center align-items-center">
				<article class=" message ">
					<div id="toast-container text-center d-flex justify-content-center">
						<span class="fs-2">
							<i class="bi bi-check-circle message-success fs-2 fw-bold"></i>
							{{ message }}
						</span>
					</div>
				</article>
			</div>
		{% endif %}
	{% endfor %}
	{% for message in app.flashes('admin_create_point') %}
		{% if message %}
			<div class=" row w-100 d-flex justify-content-center align-items-center">
				<article class=" message ">
					<div id="toast-container text-center d-flex justify-content-center">
						<span class="fs-2">
							<i class="bi bi-check-circle message-success fs-2 fw-bold"></i>
							{{ message }}
						</span>
					</div>
				</article>
			</div>
		{% endif %}
	{% endfor %}
	{% for message in app.flashes('admin_create_trajet') %}
		{% if message %}
			<div class=" row w-100 d-flex justify-content-center align-items-center">
				<article class=" message ">
					<div id="toast-container text-center d-flex justify-content-center">
						<span class="fs-2">
							<i class="bi bi-check-circle message-success fs-2 fw-bold"></i>
							{{ message }}
						</span>
					</div>
				</article>
			</div>
		{% endif %}
	{% endfor %}

	<div class="d-flex">

		<div id="menu" class=" px-3 vh-100 borderDashboard border border-1" style="width: 250px;">

			<h1 class=" mb-5 text-center" style="color: white;">
				<span style="color: var(--color-btn-primary-hover);">Bus</span>Track</h1>
			<ul class="nav flex-column responsiveNav w-100 text-start">
				<li class="nav-item mb-3">
					<a class="nav-link  active  fs-3 colorDashboard" href="#">
						<i class="bi bi-house"></i>
						<span class=" fs-5">Dashboard</span>
					</a>
				</li>

				<li class="nav-item mb-3">
					<a class="nav-link  fs-3 colorDashboard" href="{{ path('app_buss_index') }}">
						<i class="fas fa-bus"></i>
						<span class=" fs-5">Bus</span>
					</a>
				</li>

				<li class="nav-item mb-3">
					<a class="nav-link   fs-3 colorDashboard" href="{{path('app_conducteurs_index')}}">
						<i class="fas fa-user-tie"></i>
						<span class=" fs-5">Conducteurs</span>
					</a>
				</li>

				<li class="nav-item mb-3">
					<a class="nav-link fs-3 colorDashboard" href="{{ path('app_trajets_index')}}">
						<i class="fas fa-route"></i>
					</i>
					<span class=" fs-5">
						Trajet</span>
				</li>
			</a>
		</li>

		<li class="nav-item mb-3">
			<a class="nav-link fs-3 colorDashboard" href="{{ path('app_point_index') }}">
				<i class="bi bi-geo-alt"></i>
				<span class=" fs-6">Point</span>
			</a>
		</li>
		<li class="nav-item mt-3">
			<a id="danger" class="nav-link text-danger fs-3 colorDashboard" href="{{path ('deconnexion')}}">
				<i class="bi bi-box-arrow-right"></i>
				<span class=" fs-5">Déconnexion</span>
			</a>
		</li>
	</ul>
</div>

<div class="corps-5">
	<header class="w-100">
		<span>
			
				<h3 class=" d-inline text-black ">Tableau de bord</h3><br><small>Vue d'ensemble du systeme</small>		
		</span>
		<button class="Ajouter d-inline position-absolute end-0 top-0 my-2 mx-1 btn-sm" data-bs-toggle="modal" data-bs-target="#busModal">
			A
		</button>
		<hr>
	</header>
	<div class="corps-7">

		{# Mot de bienvenu #}

		<div cla>
			
		</div>

		<div id="animate" class="container-fluid Dashboard ">
			<h3 style="color: var(--color-text-primary);">Actions rapides</h3>
			<div class="mt-3  row gap-3 gap-4">
				<div class=" mx-2 pe-4 row gap-3 gap-4">
					<div class="col rounded action text-center d-grid align-items-center " data-bs-toggle="modal" data-bs-target="#conducteurModal">
						<i class="fas fa-user-tie fs-1 colorIcon"></i>Ajouter un Conducteur
					</div>
					<div class="col rounded action text-center d-grid align-items-center" data-bs-toggle="modal" data-bs-target="#trajetModal">
						<i class="fas fa-route fs-1 colorIcon"></i>
						Ajouter un Trajet
					</div>
					<div class="col  rounded action text-center d-grid align-items-center" data-bs-toggle="modal" data-bs-target="#pointModal">
						<i class="fas fa-map-marker-alt fs-1 colorIcon"></i>Ajouter un Point
					</div>

				</div>
				<div class="mt-3 pe-4 row  mx-2 gap-3 gap-4" data-bs-toggle="modal" data-bs-target="#busModal">
					<div class="col rounded action text-center d-grid align-items-center">
						<i class="fas fa-bus fs-1 colorIcon"></i>Ajouter un Bus</div>
				</div>
			</div>
		</div>
		<div class="modal fade" id="busModal" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content content-modal">

					<div class="modal-header entete_form">
						<h5 class="modal-title text-center title-modal">
							<i class="fas fs-3 fa-bus"></i>Ajouter un bus</h5>
					</div>

					<div class="modal-body">

						{{ form_start(form) }}
						{{ form_row(form.nom, {
							'attr': {'class': 'form-control form_control',
							'placeholder': 'Entrer le Nom',
							'type':'text',
							
						
						}}) }}

						{{ form_row(form.capacite, {'attr': {
							'class': 'form-control form_control',
							'placeholder': 'Entrer la Capacité'
						}}) }}
						{{ form_row(form.etat, {
							'attr': {'class': 'form-control form_control',
							'placeholder': 'Etat',
						}}) }}
						{{form_row(form.administrateur,{
								'attr' : {'class': 'form-control form_control'},
								'label' : 'Conducteur',
						})}}

						{{ form_row(form.trajet, {
							'attr': {'class': 'form-control form_control',
							'placeholder': 'Etat',
						}}) }}

					</div>

					<div class="modal-footer">
						<button type="button" class="Annuler position-absolute start-0 mx-4 mt-2" data-bs-dismiss="modal">Annuler</button>
						<button class="Enregistrer mx-4 mt-1">Enregistrer</button>
						{{ form_end(form)  }}
					</div>

				</div>
			</div>
		</div>
		<div class="modal fade" id="conducteurModal" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content content-modal">

					<div class="modal-header entete_form">
						<h5 class="modal-title text-center title-modal">
							<i class="bi bi-person-add fs-3"></i>Ajouter un Conducteur</h5>
					</div>

					<div class="modal-body">

						{{ form_start(formDriver) }}
						{{ form_row(formDriver.nom, {
								'attr': {'class': 'form-control form_control',
								'placeholder': 'Entrer le Nom'							
							}}) }}
						{{ form_row(formDriver.username, {
								'attr': {'class': 'form-control form_control',
								'placeholder': 'Entrer le Prenom'
							}}) }}

						{{ form_row(formDriver.password, {'attr': {
								'class': 'form-control form_control',
								'placeholder': 'Entrer le mot de passe'
							}}) }}
						{{ form_row(formDriver.bus, {
								'attr': {'class': 'form-control form_control',
								'placeholder': 'Assigner un Bus'								
							}}) }}
						{{ form_row(formDriver.telephone, {
								'attr': {'class': 'form-control form_control',
								'placeholder': 'Numero',

								'type':'tel',
								'value': '+237'
							}}) }}


					</div>

					<div class="modal-footer">
						<button type="button" class="Annuler position-absolute start-0 mx-4 mt-2" data-bs-dismiss="modal">Annuler</button>
						<button class="Enregistrer mx-4 mt-1">Enregistrer</button>
						{{ form_end(formDriver) }}
					</div>

				</div>
			</div>
		</div>
		<div class="modal fade" id="pointModal" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content content-modal">

					<div class="modal-header entete_form">
						<h5 class="modal-title text-center title-modal">
							<i class="bi bi-person-add fs-3"></i>Ajouter un point</h5>
					</div>

					<div class="modal-body">

						{{ form_start(formPoint) }}
						{{ form_row(formPoint.nom, {
							'attr': {'class': 'form-control form_control',
							'placeholder': 'Entrer le Nom'
						}}) }}
						{{ form_row(formPoint.description, {
							'attr': {'class': 'form-control form_control',
							'placeholder': 'Ex:Ndokiti coté Brasserie',
						}}) }}

					</div>

					<div class="modal-footer">
						<button type="button" class="Annuler position-absolute start-0 mx-4 mt-2" data-bs-dismiss="modal">Annuler</button>
						<button class="Enregistrer mx-4 mt-1">Enregistrer</button>
						{{ form_end(formPoint) }}
					</div>

				</div>
			</div>
		</div>

		{# formulaire d'ajout du trajet #}
		<div class="modal fade" id="trajetModal" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content content-modal">

					<div class="modal-header entete_form">
						<h5 class="modal-title text-center title-modal">
							<i class="fas fa-route fs-3"></i>Ajouter un trajet</h5>
					</div>

					<div class="modal-body">

						{{ form_start(formTrajet) }}
						{{ form_row(formTrajet.nom, {
            'attr': {'class': 'form-control form_control',
            'placeholder': 'Entrer le Nom'
        
        }}) }}
						{{ form_row(formTrajet.ligne,
             {'attr':
                {
                    'type': 'text',
                    'class': 'form-control form_control',
                    'placeholder': 'ligne12',
                }             
             }        
        )}}

						{{ form_row(formTrajet.etat, {'attr': {
            'class': 'form-control form_control',
            'placeholder': ''
        }}) }}
						{{ form_row(formTrajet.zone, {'attr': {
            'class': 'form-control form_control',
            'placeholder': ''
        }}) }}
						{{ form_row(formTrajet.depart, {'attr': {
            'class': 'form-control form_control',
            'placeholder': ''
        }}) }}
						{{ form_row(formTrajet.arrivee, {'attr': {
            'class': 'form-control form_control',
            'placeholder': ''
        }}) }}

					</div>


					<div class="modal-footer">
						<button type="button" class="Annuler position-absolute start-0 mx-4 mt-2" data-bs-dismiss="modal">Annuler</button>
						<button class="Enregistrer mx-4 mt-1">Enregistrer</button>
						{{ form_end(formTrajet) }}
					</div>

				</div>
			</div>
		</div>

		<!-- Contenu -->
