{% extends 'base.html.twig' %}

{% block title %}BusTrack
{% endblock %}

{% block body %}
    {{ include('style/js.html.twig') }}
    {{ include('style/style.html.twig') }}
    {{ include('style.html.twig') }}
    
    <link rel="stylesheet" href="{{ asset('css1/driver/conducteurs.css') }}">
    <link rel="stylesheet" href="{{ asset('css1/driver/root.css') }}">
    <link rel="stylesheet" href="{{ asset('css/bootstrap.css') }}">

    <body class="driver-body">
        <!-- EN-TÊTE MODERNE -->
        <header class="driver-header">
            <div class="container-fluid h-100">
                <div class="row h-100 align-items-center">
                    <div class="col-6">
                        <a href="{{ path('app_interface_conducteur') }}" class="driver-logo-link">
                            <h3 class="driver-logo mb-0">
                                <span class="driver-logo-fresh">Bus</span>Track
                            </h3>
                        </a>
                    </div>
                    <div class="col-6 text-end">
                        <a href="{{ path('app_conducteur_profil') }}" class="driver-profile-link">
                            <i class="bi bi-person-circle driver-profile-icon"></i>
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- MAIN CONTENT -->
        <main class="driver-main">
            <div class="container-custom">
            <!-- CARTE INFOS BUS (statut, trajet, direction) -->
			<!-- GRILLE D'INFOS (SANS ICÔNES SAUF POUR BUS) -->
			<div class="info-grid">
				<!-- Carte Bus (avec icône conservée) -->
				<div class="info-card">
					<div class="info-card-icon">
						<i class="bi bi-bus-front"></i>
					</div>
					<div class="info-card-content">
						<span class="info-card-label">Mon bus</span>
						<span class="info-card-value">{{ bus.nom }}</span>
					</div>
				</div>

				<!-- Carte Trajet (sans icône) -->
				<div class="info-card no-icon">
					<div class="info-card-content">
						<span class="info-card-label">Trajet assigné</span>
						<span class="info-card-value">{{ trajet.nom }}</span>
					</div>
				</div>

				<!-- Carte Direction (sans icône) -->
				<div class="info-card no-icon">
					<div class="info-card-content">
						<span class="info-card-label">Direction</span>
						<span class="info-card-value direction-value">
							{% for pointA in pointASC %}
								{% for pointB in pointDESC %}
									{% if bus.direction == pointA.nom ~' vers '~ pointB.nom %}
										Aller
									{% else %}
										Retour
									{% endif %}
								{% endfor %}
							{% endfor %}
						</span>
					</div>
				</div>

				<!-- Carte Statut (sans icône) -->
				<div class="info-card no-icon">
					<div class="info-card-content">
						<span class="info-card-label">Statut actuel</span>
						<span class="info-card-value status-value {% if bus.etat == 'Incident' %}status-danger{% else %}status-success{% endif %}">
							{{ bus.etat }}
						</span>
					</div>
				</div>
			</div>

                <!-- FORMULAIRE DE MISE À JOUR -->
                <form method="post" class="update-form" action="{{ path('update_direction_bus', {'id': bus.id}) }}">
                    <div class="form-row">
                        <!-- STATUT DU BUS -->
                        <div class="form-card">
                            <div class="form-card-header">
                                {# <i class="bi bi-check-circle-fill"></i> #}
                                <span>Statut du bus</span>
                            </div>
                            <div class="form-card-body">
							<div class="status-options">
    <label class="status-option">
        <input type="radio" name="statut" value="En route">
        <div class="status-box status-enroute">
            <i class="bi bi-play-circle-fill"></i>
            <span>En route</span>
        </div>
    </label>
    <label class="status-option">
        <input type="radio" name="statut" value="Chargement">
        <div class="status-box status-chargement">
            <i class="bi bi-arrow-repeat"></i>
            <span>Chargement</span>
        </div>
    </label>
    <label class="status-option">
        <input type="radio" name="statut" value="Inactif">
        <div class="status-box status-inactif">
            <i class="bi bi-pause-circle-fill"></i>
            <span>Inactif</span>
        </div>
    </label>
    <label class="status-option">
        <input type="radio" name="statut" value="Incident">
        <div class="status-box status-incident">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>Incident</span>
        </div>
    </label>
</div>
                            </div>
                        </div>

                        <!-- DIRECTION -->
                        <div class="form-card">
                            <div class="form-card-header">
                                {# <i class="bi bi-signpost-split"></i> #}
                                <span>Direction</span>
                            </div>
                            <div class="form-card-body">
                                <div class="direction-options">
                                    {% for pointA in pointASC %}
                                        {% for pointB in pointDESC %}
                                            <label class="direction-option">
                                                <input type="radio" name="direction" value="{{ pointA.nom }} vers {{ pointB.nom }}">
                                                <div class="direction-box">
                                                    <i class="bi bi-arrow-right-circle-fill"></i>
                                                    <div>
                                                        <strong>Aller</strong>
                                                        <small>{{ pointA.nom }} → {{ pointB.nom }}</small>
                                                    </div>
                                                </div>
                                            </label>
                                            <label class="direction-option">
                                                <input type="radio" name="direction" value="{{ pointB.nom }} vers {{ pointA.nom }}">
                                                <div class="direction-box">
                                                    <i class="bi bi-arrow-left-circle-fill"></i>
                                                    <div>
                                                        <strong>Retour</strong>
                                                        <small>{{ pointB.nom }} → {{ pointA.nom }}</small>
                                                    </div>
                                                </div>
                                            </label>
                                        {% endfor %}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" name="_token" value="{{ csrf_token('update_direction' ~ bus.id) }}">
                    
                    <div class="form-submit">
                        <button type="submit" class="submit-btn">
                            <i class="bi bi-arrow-repeat"></i>
                            Mettre à jour
                        </button>
                    </div>
                </form>
            </div>
        </main>

        <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
        
        <!-- VOS SCRIPTS CONSERVÉS INTÉGRALEMENT -->
        <script>
            const radios = document.querySelectorAll('input[name="statut"]');
            radios.forEach(radio => {
                radio.addEventListener('change', function () {
                    document.querySelectorAll('.status-box').forEach(box => {
                        box.classList.remove('status-enroute', 'status-chargement', 'status-inactif', 'status-incident');
                    });
                    const box = this.nextElementSibling;
                    switch (this.value) {
                        case "En route": box.classList.add('status-enroute'); break;
                        case "Incident": box.classList.add('status-incident'); break;
                        case "Inactif": box.classList.add('status-inactif'); break;
                        case "Chargement": box.classList.add('status-chargement'); break;
                    }
                });
            });
        </script>
        <script>
            const directions = document.querySelectorAll('input[name="direction"]');
            directions.forEach(input => {
                input.addEventListener('change', function () {
                    document.querySelectorAll('input[name="direction"]').forEach(i => {
                        i.nextElementSibling.classList.remove('direction-selected');
                    });
                    const box = this.nextElementSibling;
                    box.classList.add('direction-selected');
                });
            });
        </script>
    </body>
{% endblock %}
