{% extends 'base.html.twig' %}

{% block title %}Conducteurs{% endblock %}

{% block body %}
{{ include('style.html.twig') }}
    <h1>Conducteurs</h1>
    
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ conducteur.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ conducteur.nom }}</td>
            </tr>
            <tr>
                <th>Telephone</th>
                <td>{{ conducteur.telephone }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_conducteurs_index') }}">retour</a>

    <a href="{{ path('app_conducteurs_edit', {'id': conducteur.id}) }}">Modifier</a>

    {{ include('conducteurs/_delete_form.html.twig') }}
{% endblock %}
