{% extends 'base.html.twig' %}

{% block title %}Conducteurs index{% endblock %}
 
{% block body %}
 {{ include('style.html.twig') }}
 <link rel="stylesheet" href="css1/admin/form.css">

    <header>
        <h1 class=" d-inline">Gestion des Conducteurs</h1>
        <button class="Ajouter d-inline position-absolute end-0 my-2 mx-1 btn-sm" data-bs-toggle="modal" data-bs-target="#busModal">
            Ajouter Bus
        </button>
    </header>

    <div class=" table-responsive">
          <table class="table table-hover table-sm text-center">
            <thead class=" table-dark fs-5">
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Telephone</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody class=" table-secondary">
            {% for conducteur in conducteurs %}
                <tr class="w-75">
                    <td>{{ conducteur.id }}</td>
                    <td>{{ conducteur.nom }}</td>
                    <td>{{ conducteur.telephone }}</td>
                    <td>
                        <a href="{{ path('app_conducteurs_edit', {'id': conducteur.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('app_conducteurs_delete', {'id': conducteur.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ conducteur.id) }}">
                            <button class="btn btn-danger btn-sm ">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Aucun Bus Enregistrer</td>
                </tr>
            {% endfor %}
            </tbody>
    </table>
    </div>

    {# <a href="{{ path('app_conducteurs_new') }}">Nouveau Bus</a> #}

    <div class="modal fade" id="busModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content content-modal">

      <div class="modal-header entete_form">
        <h5 class="modal-title text-center title-modal"><i class="bi bi-person-add fs-3"></i>Ajouter un Conducteur</h5>
      </div>

      <div class="modal-body">

        {{ form_start(form) }}
      {{ form_row(form.nom, {
        'attr': {'class': 'form-control',
        'placeholder': 'Entrer le Nom'
        
      
      }}) }}
       
        {{ form_row(form.password, {'attr': {
            'class': 'form-control',
            'placeholder': 'Entrer le mot de passe'
            }}) }}
        {{ form_row(form.telephone, {
            'attr': {'class': 'form-control',
            'placeholder': 'Numero',
            'pattern': '[0-9]{9}',
            'type':'tel',
            'value': '+237'
            }}) }}

      </div>

      <div class="modal-footer">
      <button type="button" class="Annuler position-absolute start-0 mx-4 mt-2" data-bs-dismiss="modal">Annuler</button>
        <button class="Enregistrer mx-4 mt-1">Enregistrer</button>
        {{ form_end(form) }}
      </div>

    </div>
  </div>
</div>
 
{% endblock %}
