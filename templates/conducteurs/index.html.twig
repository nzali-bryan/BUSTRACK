{% extends 'base.html.twig' %}

{% block title %}Conducteurs index{% endblock %}
 
{% block body %}
 {{ include('style.html.twig') }}
 <link rel="stylesheet" href="css1/admin/form.css">


 <div id="menu" class=" px-3 vh-100 borderDashboard border border-1" style="width: 250px;">
        
        <h1 class=" mb-5 text-center" style="color: white;"><span style="color: var(--color-btn-primary-hover);">Bus</span>Track</h1>
        <ul class="nav flex-column w-100 text-start">
            <li class="nav-item my-1">
                <a  class="nav-link   fs-3 colorDashboard" href="{{ path('app_administrateur_index') }}">
                    <i class="bi bi-house"></i> <span class=" fs-5">Dashboard</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link  fs-3 colorDashboard" href="#">
                     <i class="fas fa-bus"></i><span class=" fs-5">Bus</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link active  fs-3 colorDashboard" href="#animate">
                   <i class="fas fa-user-tie"></i> <span class=" fs-5">Conducteurs</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link fs-3 colorDashboard" href="#">
                   <i class="fas fa-route"></i></i> <span class=" fs-5"> Trajet</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link fs-3 colorDashboard" href="#">
                   <i class="bi bi-geo-alt"></i><span class=" fs-6">Point</span>
                </a>
            </li>
            <li class="nav-item my-3">
                <a id="danger" class="nav-link text-danger fs-3 colorDashboard" href="#">
                    <i class="bi bi-box-arrow-right"></i> <span class=" fs-5">Déconnexion</span>
                </a>
            </li>
        </ul>
    </div>


<div class="corps">

    <header>
        <h1 class=" d-inline">Gestion des Conducteurs</h1>
        <button class="Ajouter d-inline position-absolute end-0 my-2 mx-1 btn-sm" data-bs-toggle="modal" data-bs-target="#busModal">
            Ajouter Bus
        </button>
        <hr>
    </header>

    <div class=" table-responsive mx-2 rounded rounded-2 mt-3">
          <table class="table table-hover table-sm text-center">
            <thead class=" table-dark fs-5">
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Telephone</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody class=" table-secondary">
            {% for conducteur in conducteurs %}
                <tr class="w-75">
                    <td>{{ conducteur.id }}</td>
                    <td>{{ conducteur.nom }}</td>
                    <td>{{ conducteur.telephone }}</td>
                    <td>
                        <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#editConducteur{{ conducteur.id }}">
                            <i class="bi bi-pencil ajouter"></i>
                        </button>
                        {# <a href="{{ path('app_conducteurs_edit', {'id': conducteur.id}) }}">Modifier</a> #}
                        <form method="post" action="{{ path('app_conducteurs_delete', {'id': conducteur.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ conducteur.id) }}">
                            <button class="btn btn-danger btn-sm "><i class="bi bi-trash"></i>Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Aucun Bus Enregistrer</td>
                </tr>
            {% endfor %}
            </tbody>
    </table>
    </div>

    {# <a href="{{ path('app_conducteurs_new') }}">Nouveau Bus</a> #}

    <div class="modal fade" id="busModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content content-modal">

      <div class="modal-header entete_form">
        <h5 class="modal-title text-center title-modal"><i class="bi bi-person-add fs-3"></i>Ajouter un Conducteur</h5>
      </div>

      <div class="modal-body">

        {{ form_start(form) }}
      {{ form_row(form.nom, {
        'attr': {'class': 'form-control',
        'placeholder': 'Entrer le Nom'
        
      
      }}) }}
       
        {{ form_row(form.password, {'attr': {
            'class': 'form-control',
            'placeholder': 'Entrer le mot de passe'
            }}) }}
        {{ form_row(form.telephone, {
            'attr': {'class': 'form-control',
            'placeholder': 'Numero',
            'pattern': '[0-9]{9}',
            'type':'tel',
            'value': '+237'
            }}) }}

      </div>

      <div class="modal-footer">
      <button type="button" class="Annuler position-absolute start-0 mx-4 mt-2" data-bs-dismiss="modal">Annuler</button>
        <button class="Enregistrer mx-4 mt-1">Enregistrer</button>
        {{ form_end(form) }}
      </div>

    </div>
  </div>
</div>

</div>






{% for conducteur in conducteurs %}

<div class="modal fade" id="editConducteur{{ conducteur.id }}" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header entete_form">
        <h5 class="modal-title text-center title-modal"><i class="bi bi-person-add fs-3"></i>Modifier Conducteur</h5>
      </div>

      <div class="modal-body">

        <form method="post" action="{{ path('app_conducteurs_edit', {'id': conducteur.id}) }}">

            <div class="mb-3">
                <label>Nom</label>
                <input type="text" name="conducteurs[nom]" value="{{ conducteur.nom }}" class="form-control">
            </div>
            <div class="mb-3">
                <label>Nouveau Mot de Passe</label>
                <input type="password" name="conducteurs[password]" value="" class="form-control" required>
            </div>
            <div class="mb-3">
                <label>Téléphone</label>
                <input type="tel" name="conducteurs[telephone]" value="{{ conducteur.telephone }}" class="form-control">
            </div>
            <div class="modal-footer">
                <button type="button" class="Annuler position-absolute start-0 mx-4 mt-2" data-bs-dismiss="modal">Annuler</button>
                <button class="Enregistrer mx-4 mt-1">Modifier</button>
            </div>
        </form>

      </div>

    </div>
  </div>
</div>

{% endfor %}


<script>
    const links = document.querySelectorAll("#menu .nav-link");

    links.forEach(link => {
            link.addEventListener("click", function(){

            // enlever active sur tous les liens
            links.forEach(l => l.classList.remove("active"));

            // ajouter active au lien cliqué
            this.classList.add("active");

            });
    });
</script>
{% endblock %}
