{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
 
{% block body %}
 {{ include('style.html.twig') }}
 <link rel="stylesheet" href="css1/admin/form.css">


 <div id="menu" class=" px-3 vh-100 borderDashboard border border-1" style="width: 250px;">
        
        <h1 class=" mb-5 text-center" style="color: white;"><span style="color: var(--color-btn-primary-hover);">Bus</span>Track</h1>
        <ul class="nav flex-column w-100 text-start">
            <li class="nav-item my-1">
                <a  class="nav-link   fs-3 colorDashboard" href="{{ path('app_administrateur_index') }}">
                    <i class="bi bi-house"></i> <span class=" fs-5">Dashboard</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link  fs-3 colorDashboard" href="#">
                     <i class="fas fa-bus"></i><span class=" fs-5">Bus</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link  fs-3 colorDashboard" href="{{path('app_conducteurs_index')}}">
                   <i class="fas fa-user-tie"></i> <span class=" fs-5">Conducteurs</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link fs-3 colorDashboard" href="{{ path('app_trajets_index')}}">
                   <i class="fas fa-route"></i></i> <span class=" fs-5"> Trajet</span>
                </a>
            </li>

            <li class="nav-item my-3">
                <a class="nav-link active fs-3 colorDashboard" href="#">
                   <i class="bi bi-geo-alt"></i><span class=" fs-6">Point</span>
                </a>
            </li>
            <li class="nav-item my-3">
                <a id="danger" class="nav-link text-danger fs-3 colorDashboard" href="#">
                    <i class="bi bi-box-arrow-right"></i> <span class=" fs-5">Déconnexion</span>
                </a>
            </li>
        </ul>
    </div>


<div class="corps">

    <header>
        <h1 class=" d-inline">Gestion des Points</h1>
        <button class="Ajouter d-inline position-absolute end-0 my-2 mx-1 btn-sm" data-bs-toggle="modal" data-bs-target="#busModal">
            Ajouter Point
        </button>
        <hr>
    </header>

    <div class=" table-responsive mx-2 rounded rounded-2 mt-3">
          <table class="table table-hover table-sm text-center">
            <thead class=" table-dark fs-5">
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Zone</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody class=" table-secondary">
            {% for point in points %}
                <tr class="w-75">
                    <td>{{ point.id }}</td>
                    <td>{{ point.nom }}</td>
                    <td>{{ point.zone }}</td>
                    <td>

                            <button class="btn ajouter btn-sm" data-bs-toggle="modal" data-bs-target="#editpoint{{ point.id }}">
                                <i class="bi bi-pencil"></i>Modifier
                            </button>
   
                        {# <a href="{{ path('app_points_edit', {'id': point.id}) }}">Modifier</a> #}
                        <form class="mt-1" method="post" action="{{ path('app_point_delete', {'id': point.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ point.id) }}">
                            <button class="btn btn-danger btn-sm "><i class="bi bi-trash"></i>Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Aucun point Enregistrer</td>
                </tr>
            {% endfor %}
            </tbody>
    </table>
    </div>

    {# <a href="{{ path('app_points_new') }}">Nouveau Bus</a> #}

    <div class="modal fade" id="busModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content content-modal">

      <div class="modal-header entete_form">
        <h5 class="modal-title text-center title-modal"><i class="bi bi-person-add fs-3"></i>Ajouter un point</h5>
      </div>

      <div class="modal-body">

        {{ form_start(form) }}
      {{ form_row(form.nom, {
        'attr': {'class': 'form-control',
        'placeholder': 'Entrer le Nom'
        
      
      }}) }}
       
        {{ form_row(form.zone, {'attr': {
            'class': 'form-control',
            'placeholder': 'Entrer la zone'
            }}) }}
        {{ form_row(form.description, {
            'attr': {'class': 'form-control',
            'placeholder': 'Ex:Ndokiti coté Brasserie',
        }}) }}

      </div>

      <div class="modal-footer">
      <button type="button" class="Annuler position-absolute start-0 mx-4 mt-2" data-bs-dismiss="modal">Annuler</button>
        <button class="Enregistrer mx-4 mt-1">Enregistrer</button>
        {{ form_end(form) }}
      </div>

    </div>
  </div>
</div>

</div>






{% for point in points %}

<div class="modal fade" id="editpoint{{ point.id }}" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header entete_form">
        <h5 class="modal-title text-center title-modal"><i class="bi bi-person-add fs-3"></i>Modifier point</h5>
      </div>

      <div class="modal-body">

        <form method="post" action="{{ path('app_point_edit', {'id': point.id}) }}">

            <div class="mb-3">
                <label>Nom</label>
                <input type="text" name="points[nom]" value="{{ point.nom }}" class="form-control">
            </div>

            <div class="mb-3">
                <label>Zone</label>
                <input type="text" name="points[zone]" value="{{ point.zone }}" class="form-control">
            </div>
            <div class="mb-3">
                <label>Description</label>
                <input type="text" name="points[description]" value="{{ point.description }}" class="form-control">
            </div>
            <div class="modal-footer">
                <button type="button" class="Annuler position-absolute start-0 mx-4 mt-2" data-bs-dismiss="modal">Annuler</button>

                <button class="Enregistrer mx-4 mt-1">Modifier</button>
            </div>
        </form>

      </div>

    </div>
  </div>
</div>

{% endfor %}


<script>
    const links = document.querySelectorAll("#menu .nav-link");

    links.forEach(link => {
            link.addEventListener("click", function(){

            // enlever active sur tous les liens
            links.forEach(l => l.classList.remove("active"));

            // ajouter active au lien cliqué
            this.classList.add("active");

            });
    });
</script>
{% endblock %}
