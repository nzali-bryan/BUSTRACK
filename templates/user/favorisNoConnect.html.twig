{% extends 'base.html.twig' %}

{% block title %}BusTrack
{% endblock %}

{% block body %}
	{{ include('style/style.html.twig') }}
	{{ include('style/js.html.twig') }}
	<link rel="stylesheet" href="{{asset('css1/admin/form.css')}}">
	<link rel="stylesheet" href="{{asset('css1/user/passager.css')}}">
	<header class="bt-header">

  <a class="bt-logo" href="#">
    <div class="bt-logo-ic"><i class="bi bi-bus-front-fill"></i></div>
    <div class="bt-logo-tx">Bus<span>Track</span></div>
  </a>

  {% if app.user %}
    <form method="GET" class="bt-search-form" action="{{ path('app_user') }}">
      <input type="text" name="mot" required placeholder="Trajets, Points, Bus…">
      <button type="submit">Rechercher</button>
    </form>
  {% else %}
    <form method="GET" class="bt-search-form" action="{{ path('app_user') }}">
      <input type="text" name="mot" required placeholder="Trajets, Points, Bus…">
      <button type="submit">Rechercher</button>
    </form>
  {% endif %}

  
    {% if app.user %}
      {# utilisateur connecté#}
    {% else %}
    <div class="bt-header-actions">
      <a href="{{ path('app_login') }}" class="bt-btn bt-btn-outline">
        <i class="bi bi-box-arrow-in-right"></i> Connexion
      </a>
    </div>
    {% endif %}
  

</header>


<nav class="bt-nav-bar">
  <div class="bt-nav-links" id="menu1">
    <a href="{{ path('app_user') }}" class="bt-nav-link ">Bus en temps réel</a>

    {% if app.user %}
      <a href="{{ path('favoris_list') }}" class="bt-nav-link active">Mes favoris</a>
    {% else %}
      <a href="{{ path('app_user_favoris_NoConnect') }}" class="bt-nav-link active ">Mes favoris</a>
    {% endif %}

    {% if app.user %}
      <a href="{{ path('app_user_profil') }}" class="bt-nav-link ">Profil</a>
    {% else %}
      <a href="{{ path('app_user_profil_NoConnect') }}" class="bt-nav-link ">Profil</a>
    {% endif %}
  </div>
</nav>
	<main class=" min-vw-100 mt-4 min-vh-100 body-color">
		<div class="haut-favoris haut-1 container rounded rounded-4">
			<h3 class="text-white">❤️Mes trajets favoris
			</h3>
			<span class="text-secondary">Vos lignes préférées avec toutes leurs informations directement ici
			</span>

		</div>

		<div class="corps2 corps3 ">
			<div class="bg-white container d-grid justify-content-center  border border-secondary-subtle text-center rounded rounded-4 py-3">
				<i class="bi bi-person fs-4"></i>
				<h3>Non Connecté</h3>
				<span class=" text-secondary my-1">Connectez-vous pour acceder à vos favoris</span>
				<div class="Enregistrement1 d-flex align-items-center justify-content-center rounded-2 my-2 " style="height:50px">
					<a class="nav-link w-100 text-center mx-1 fs-3" href="{{path('app_login')}}">
						<i class="bi bi-box-arrow-in-right text-black fs-1"></i>
						<span class="pb-5 ms-2">Se Connecter</span>
					</a>
				</div>


			</div>
		</div>
		

	</main>
	<script src="js/bootstrap.bundle.min.js"></script>

	<script>
document.querySelectorAll('#menu1 .bt-nav-link').forEach(link => {
    link.addEventListener('click', () => {
        document.querySelectorAll('#menu1 .bt-nav-link').forEach(l => l.classList.remove('active'));
        link.classList.add('active');
    });
});
	</script>
{% endblock %}
