{% extends 'base.html.twig' %}

{% block title %}BusTrack{% endblock %}

{% block body %}
{{ include('style/style.html.twig') }}
{{ include('style/js.html.twig') }}

<style>
:root {
    --cf: #0A1628;
    --cp: #019271;
    --cph: #00C9A7;
    --cbg: #F5F7FA;
    --csf: #ffffff;
    --cbo: #DDE4EC;
    --ct1: #0D1B2A;
    --ct2: #5A7184;
    --cer: #C76D6D;
    --tr: .25s ease;
}

body { background: var(--cbg); }

/* Petits ajustements Bootstrap */
.bt-card {
    border: 1.5px solid var(--cbo);
    border-top: 4px solid var(--cph);
    border-radius: 16px;
    box-shadow: 0 4px 15px rgba(13,27,42,0.07);
}

.profile-avatar {
    width: 110px;
    height: 110px;
    background: linear-gradient(135deg, var(--cp), var(--cph));
    color: white;
    font-size: 2.8rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 6px solid var(--csf);
    box-shadow: 0 8px 25px rgba(0,201,167,0.3);
}
</style>

{# Flash messages #}
<div class="flash-wrap mt-5 pt-3">
    {% for message in app.flashes('error_password') %}
        <div class="alert alert-danger text-center mx-auto" style="max-width: 520px;">
            <i class="bi bi-x-circle"></i> {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('success_edit') %}
        <div class="alert alert-success text-center mx-auto" style="max-width: 520px;">
            <i class="bi bi-check-circle"></i> {{ message }}
        </div>
    {% endfor %}
</div>

{# HEADER #}
<header class="bt-header">
    <a class="bt-logo" href="{{ path('app_user') }}">
        <div class="bt-logo-ic"><i class="bi bi-bus-front-fill"></i></div>
        <div class="bt-logo-tx">Bus<span>Track</span></div>
    </a>

    <form method="GET" class="bt-search-form" action="{{ path('app_user') }}">
        <input type="text" name="mot" required placeholder="Trajets, Points, Bus…">
        <button type="submit">Rechercher</button>
    </form>
</header>

{# NAV #}
<nav class="bt-nav-bar">
    <div class="bt-nav-links" id="menu1">
        <a href="{{ path('app_user') }}" class="bt-nav-link">Bus en temps réel</a>
        <a href="{{ path('favoris_list') }}" class="bt-nav-link">Mes favoris</a>
        <a href="{{ path('app_user_profil') }}" class="bt-nav-link active">Profil</a>
    </div>
</nav>

<main class="container-90  mt-5 pt-4" >
    <div class="text-center mb-5 mt-5">
        <div class="profile-avatar mx-auto rounded-circle mb-3">
            {{ app.user.nom|first|upper }}
        </div>
        <h2 class="fw-bold">Bonjour, {{ app.user.nom|capitalize }}</h2>
    </div>

    <div class="card bt-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-person fs-3 text-success"></i>
                <h5 class="mb-0 fw-semibold">Informations personnelles</h5>
            </div>
            <button class="btn btn-success btn-sm px-4" data-bs-toggle="modal" data-bs-target="#busModal">
                Modifier
            </button>
        </div>

        <div class="row g-4 text-center">
            <div class="col-12 col-md-4">
                <small class="text-muted d-block">Nom</small>
                <strong class="fs-5">{{ user.nom|capitalize }}</strong>
            </div>
            <div class="col-12 col-md-4">
                <small class="text-muted d-block">Username</small>
                <strong class="fs-5">{{ user.username }}</strong>
            </div>
            <div class="col-12 col-md-4">
                <small class="text-muted d-block">Mot de passe</small>
                <strong class="fs-5">••••••••</strong>
            </div>
        </div>
    </div>

    <a href="{{ path('deconnexion') }}" class="btn btn-outline-danger w-100 py-3 fw-semibold d-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-box-arrow-right"></i>
        Se déconnecter
    </a>
</main>

<!-- Modal Modification -->
<div class="modal fade" id="busModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal"></button>
                <h5 class="modal-title w-100 text-center">
                    <i class="bi bi-pencil-square"></i> Modifier mes informations
                </h5>
            </div>
            <div class="modal-body p-4">
                {{ form_start(form) }}
                {{ form_row(form.nom, {'attr': {'class': 'form-control'}}) }}
                {{ form_row(form.username, {'attr': {'class': 'form-control'}}) }}
                {{ form_row(form.currentPassword, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe actuel'}}) }}
                {{ form_row(form.newPassword, {'attr': {'class': 'form-control', 'placeholder': 'Nouveau mot de passe'}}) }}
                
                <button type="submit" class="btn btn-success w-100 py-3 mt-3 fw-bold">
                    Enregistrer les modifications
                </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<script src="js/bootstrap.bundle.min.js"></script>
<script>
// Active nav
document.querySelectorAll('#menu1 .bt-nav-link').forEach(link => {
    link.addEventListener('click', () => {
        document.querySelectorAll('#menu1 .bt-nav-link').forEach(l => l.classList.remove('active'));
        link.classList.add('active');
    });
});
</script>
{% endblock %}