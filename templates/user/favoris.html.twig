                            <div class="fw-bold mt-1">{{ bus.nom|capitalize }}</div>
                            <small class="text-muted">Bus</small>
                        </div>
                        <div class="col-6 col-md-3">
                            <i class="bi bi-person-badge-fill fs-4 text-dark"></i>
