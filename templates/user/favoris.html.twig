				</div><hr>
			{% endif %}
		{% endfor %}
		<header class="entete1 fond row title position-fixed min-vw-100 m-0">
			<h3 class=" text-white col-3">
				<span class="color-fresh">Bus</span>Track</h3>


			<form method="GET" class="col-4 col-sm-6 h-75  my-1 position-absolute end-0" action="{{path('app_user')}}">
				<input type="text" name="mot" class="mt-1 w-75 h-100 text-start  rounded rounded-2 connexion  recherche" required placeholder="Trajets,Point et Bus">
				<button class="btn btn-sm filtrer h-100 mb-1">Rechercher</button>
			</form>


			<div class="sous-entete position-fixed bg-white w-100 ">
				<nav class="nav color-fresh " id="menu1">
					<a href="{{path('app_user')}}" class="nav-links mx-2 mt-1 mt-xxl-3 color-norm">Bus en temps réel</a>
					<a href="#" class="nav-links mx-2 mt-1 mt-xxl-3  color-fresh active">Mes favoris</a>
					<a href="{{path('app_user_profil' , {'id':app.user.id})}}" class="nav-links mx-2 mt-1 mt-xxl-3  color-norm">Profil</a>
				</nav>
				<hr class="mb-0">
			</div>
		</header>

		<div class="corps2">
			<div class=" haut-favoris container rounded rounded-4">
				<div class="row">
					<div class=" col-sm-8 col-xl-9">
						<h3 class="text-white">❤️Mes trajets favoris
						</h3>
						<span class="text-secondary">Vos lignes préférées avec toutes leurs informations directement ici
						</span>
					</div>
					<div class="col-sm-3 ms-3 col-xl-2">
						<div class="rounded rounded-3 text-center nombre-favoris  fw-bold">
							<p class="fs-1 m-0">{{countfavoris}}
							</p>
							<small class=" text-secondary fs-6 fw-normal">Lignes Favoris</small>

						</div>
						<button class="btn btn-danger dang btn-xxl rounded-2">
							<a href="{{path('favoris_delete_All')}}" class=" text-decoration-none text-danger w-100">
								<i class="bi bi-trash" style="color:red;"></i>
								Tous Supprimer</a>
						</button>

					</div>
