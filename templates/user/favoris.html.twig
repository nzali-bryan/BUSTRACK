                            <i class="bi bi-people-fill fs-4 text-dark"></i>
                            <div class="fw-bold mt-1">{{ bus.capacite }}</div>
                            <small class="text-muted">Places</small>
                        </div>
                        <div class="col-6 col-md-3">
                            <i class="bi bi-geo-alt-fill fs-4 text-success"></i>
                            <div class="fw-bold mt-1">
                                {% if bus.etat == 'Inactif' %}En attente
                                {% else %}
                                    {% set parts = bus.direction|lower|split('vers') %}
                                    {{ parts|length > 1 ? parts[1]|trim|capitalize : 'Inconnu' }}
                                {% endif %}
                            </div>
                            <small class="text-muted">Prochain arrêt</small>
                        </div>
                    </div>
                </div>
            </div> #}
        {% endfor %}
    {% endif %}
</main>

<script src="js/bootstrap.bundle.min.js"></script>
<script>
// Active nav
document.querySelectorAll('#menu1 .bt-nav-link').forEach(link => {
    link.addEventListener('click', () => {
        document.querySelectorAll('#menu1 .bt-nav-link').forEach(l => l.classList.remove('active'));
        link.classList.add('active');
    });
});
</script>
{% endblock %}