{% extends 'base.html.twig' %}

{% block title %}Trajets{% endblock %}

{% block body %}
    <h1>Trajets</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ trajet.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ trajet.nom }}</td>
            </tr>
            <tr>
                <th>Etat</th>
                <td>{{ trajet.etat }}</td>
            </tr>
            <tr>
                <th>Ligne</th>
                <td>{{ trajet.ligne }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_trajets_index') }}">back to list</a>

    <a href="{{ path('app_trajets_edit', {'id': trajet.id}) }}">edit</a>

    {{ include('trajets/_delete_form.html.twig') }}
{% endblock %}
