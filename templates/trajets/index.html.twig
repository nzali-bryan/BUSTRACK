{% extends 'base.html.twig' %}

{% block title %}Dashboard
{% endblock %}

{% block body %}
	{{ include('style.html.twig') }}
	{{ include('style/js.html.twig')}}
	<link rel="stylesheet" href="css1/admin/form.css">


	<div id="menu" class=" px-3 vh-100 borderDashboard border border-1" style="width: 250px;">

		<h1 class=" mb-5 text-center" style="color: white;">
			<span style="color: var(--color-btn-primary-hover);">Bus</span>Track</h1>
		<ul class="nav flex-column responsiveNav w-100 text-start">
			<li class="nav-item mb-3">
				<a class="nav-link   fs-3 colorDashboard" href="{{ path('app_administrateur_index') }}">
					<i class="bi bi-house"></i>
					<span class=" fs-5">Dashboard</span>
				</a>
			</li>

			<li class="nav-item mb-3">
				<a class="nav-link  fs-3 colorDashboard" href="{{ path('app_buss_index') }}">
					<i class="fas fa-bus"></i>
					<span class=" fs-5">Bus</span>
				</a>
			</li>

			<li class="nav-item mb-3">
				<a class="nav-link  fs-3 colorDashboard" href="{{path('app_conducteurs_index')}}">
					<i class="fas fa-user-tie"></i>
					<span class=" fs-5">Conducteurs</span>
				</a>
			</li>

			<li class="nav-item mb-3">
				<a class="nav-link active  fs-3 colorDashboard" href="#">
					<i class="fas fa-route"></i>
				</i>
				<span class=" fs-5">Trajet</span>
            	</a>
			</li>



		<li class="nav-item mb-3">
			<a class="nav-link fs-3 colorDashboard" href="{{ path('app_point_index') }}">
				<i class="bi bi-geo-alt"></i>
				<span class=" fs-6">Point</span>
			</a>
		</li>
		<li class="nav-item mt-3">
			<a id="danger" class="nav-link text-danger fs-3 colorDashboard" href="{{path ('deconnexion')}}">
				<i class="bi bi-box-arrow-right"></i>
				<span class=" fs-5">Déconnexion</span>
			</a>
		</li>
	</ul>
</div>
<div class="corps">

	<header>
		<h1 class=" d-inline">Gestion des Trajets</h1>
		<button class="Ajouter d-inline position-absolute end-0 my-2 mx-1 btn-sm" data-bs-toggle="modal" data-bs-target="#busModal">
			Ajouter Trajet
		</button>
		<hr>
	</header>

	<div class=" table-responsive mx-2 rounded rounded-2 mt-3">
		<table class="table table-hover table-sm text-center">
			<thead class=" table-dark fs-5">
				<tr>
					<th>Id</th>
					<th>Nom</th>
					<th>Zone</th>
					<th>pointA</th>
					<th>PointB</th>
					<th>Etat</th>
					<th>actions</th>
				</tr>
			</thead>
			<tbody class=" table-secondary">
				{% for trajet in trajets %}


					<tr class="w-75">

						<td>{{ trajet.id }}</td>
						<td>{{ trajet.nom }}</td>
						<td>{{ trajet.zone }}</td>
						{% for point in trajet.point%}
							<td>{{point.nom}}</td>
							{%endfor%}
							<td>{{ trajet.etat }}</td>

							<td>
								<button class="btn ajouter btn-sm" data-bs-toggle="modal" data-bs-target="#edittrajet{{ trajet.id }}">
									<i class="bi bi-pencil "></i>Modifier
								</button>
								{# <a href="{{ path('app_trajets_edit', {'id': trajet.id}) }}">Modifier</a> #}
								<form class="mt-1" method="post" action="{{ path('app_trajets_delete', {'id': trajet.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
									<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ trajet.id) }}">
									<button class="btn btn-danger dang btn-sm ">
										<i class="bi bi-trash"></i>Supprimer</button>
								</form>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6">Aucun trajet Enregistrer</td>
						</tr>
					{% endfor %}
				</tbody>
			</tbody>
		</table>
	</div>

	{# <a href="{{ path('app_trajets_new') }}">Nouveau Bus</a> #}

	<div class="modal fade" id="busModal" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content content-modal">
				{{ form_start(form) }}
				<div class="modal-header entete_form">
					<h5 class="modal-title text-center title-modal">
						<i class="fas fa-route fs-3"></i>Ajouter un trajet</h5>
				</div>

				<div class="modal-body">
					{{ form_row(form.nom, {
						'attr': {'class': 'form-control form_control',
						'placeholder': 'Entrer le Nom'
					
					}}) }}
					{{ form_row(form.ligne,
						{'attr':
							{
								'type': 'text',
								'class': 'form-control form_control',
								'placeholder': 'ligne12',
							}             
						}        
					)}}

					{{ form_row(form.etat, {'attr': {
						'class': 'form-control form_control',
						'placeholder': ''
					}}) }}
								{{ form_row(form.zone, {'attr': {
						'class': 'form-control form_control',
						'placeholder': ''
					}}) }}
					{{ form_row(form.depart, {'attr': {
						'class': 'form-control form_control',
						'placeholder': ''
					}}) }}
					{{ form_row(form.arrivee, {'attr': {
						'class': 'form-control form_control',
						'placeholder': ''
					}}) }}
					{{ form_widget(form._token) }}

				</div>


				<div class="modal-footer">
					<button type="button" class="Annuler position-absolute start-0 mx-4 mt-2" data-bs-dismiss="modal">Annuler</button>
					<button class="Enregistrer mx-4 mt-1">Enregistrer</button>
					
				</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
	{% for trajet in trajets %}

		<div class="modal fade" id="edittrajet{{ trajet.id }}" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content">

					<div class="modal-header entete_form">
						<h5 class="modal-title text-center title-modal">
							<i class="fas fa-route "></i>Modifier trajet</h5>
					</div>

					<div class="modal-body">

						<form method="post" action="{{ path('app_trajets_edit', {'id': trajet.id}) }}">

							<div class="mb-3">
								<label>Nom</label>
								<input type="text" name="trajets[nom]" value="{{ trajet.nom }}" class="form-control form_control">
							</div>
							<div class="mb-3">
								<label>Ligne</label>
								<input type="text" name="trajets[ligne]" value="{{trajet.ligne}}" class="form-control form_control" required>
							</div>
							<div class="mb-3">
								<label>Zone</label>
									<select name="trajets[zone]" id="" class="form-control form_control" required >
										<option value="DOUALA I" {% if trajet.zone=='DOUALA I' %} selected {%endif%}>DOUALA I</option>
										<option value="DOUALA II" {% if trajet.zone=='DOUALA II' %} selected {%endif%}>DOUALA II</option>
										<option value="DOUALA III" {% if trajet.zone=='DOUALA III' %} selected {%endif%}>DOUALA III</option>
										<option value="DOUALA IV" {% if trajet.zone=='DOUALA IV' %} selected {%endif%}>DOUALA IV</option>
										<option value="DOUALA V" {% if trajet.zone=='DOUALA V' %} selected {%endif%}>DOUALA V</option>
									</select>
							</div>
							<div class="mb-3">
								<label>Etat</label>
								<select name="trajets[etat]" id="" class="form-control form_control">
									<option value="actif" selected>Actif</option>
									<option value="inactif">Inactif</option>
								</select>

							</div>
							<div class="modal-footer">
								<button type="button" class="Annuler position-absolute start-0 mx-4 mt-2" data-bs-dismiss="modal">Annuler</button>
								<button class="Enregistrer mx-4 mt-1">Modifier</button>
							</div>
						</form>

					</div>

				</div>
			</div>
		</div>
	{% endfor %}
	<script>
		const links = document.querySelectorAll("#menu .nav-link");

links.forEach(link => {
link.addEventListener("click", function () { // enlever active sur tous les liens
links.forEach(l => l.classList.remove("active"));

// ajouter active au lien cliqué
this.classList.add("active");

});
});
	</script>
{% endblock %}
